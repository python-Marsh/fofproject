{
  "name": "FOF Project (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/fofproject/__init__.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "none",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit"
          }
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-notebooks.jupyter",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "sudo pip install -U pip && sudo pip install poetry && unset VIRTUAL_ENV && poetry config virtualenvs.in-project true && poetry install",
  "updateContentCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update && sudo apt-get install -y --no-install-recommends chromium chromium-driver",
  "postAttachCommand": "echo '✅ Container ready! Run: poetry run jupyter lab fund_workstation.ipynb'",
  "portsAttributes": {
    "8888": {
      "label": "Jupyter Lab",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8888
  ],
  "mounts": [
    {
      "source": "/mnt/z/Research Team/Database",
      "target": "/data",
      "type": "bind"
    }
  ]
}