# Copy this file to secrets.toml and set your password
# For Streamlit Cloud: Add this in the app settings > Secrets
password = "your_secure_password_here"

# Path to shared network folder containing return data files
# Windows: "Z:/shared/fund_data" or "//SERVER/shared/fund_data"
# Linux/Mac: "/mnt/shared/fund_data"
shared_data_path = ""
